[
    {
        "id": "tab-gateplus-demo",
        "type": "tab",
        "label": "gate-plus example",
        "disabled": false,
        "info": "Demonstrates gate-plus: data goes to output 1 while open, and to output 2 (instead of being discarded) while closed.\n\nUse the open/close/toggle inject nodes to change state, then fire \"data in\" repeatedly and watch it switch between the two debug tabs."
    },
    {
        "id": "inject-open",
        "type": "inject",
        "z": "tab-gateplus-demo",
        "name": "open",
        "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "control",
        "payload": "open",
        "payloadType": "str",
        "x": 220,
        "y": 100,
        "wires": [["gateplus-node1"]]
    },
    {
        "id": "inject-close",
        "type": "inject",
        "z": "tab-gateplus-demo",
        "name": "close",
        "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "control",
        "payload": "close",
        "payloadType": "str",
        "x": 220,
        "y": 140,
        "wires": [["gateplus-node1"]]
    },
    {
        "id": "inject-toggle",
        "type": "inject",
        "z": "tab-gateplus-demo",
        "name": "toggle",
        "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "control",
        "payload": "toggle",
        "payloadType": "str",
        "x": 230,
        "y": 180,
        "wires": [["gateplus-node1"]]
    },
    {
        "id": "inject-data",
        "type": "inject",
        "z": "tab-gateplus-demo",
        "name": "data in",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "hello",
        "payloadType": "str",
        "x": 220,
        "y": 260,
        "wires": [["gateplus-node1"]]
    },
    {
        "id": "gateplus-node1",
        "type": "gate-plus",
        "z": "tab-gateplus-demo",
        "name": "",
        "controlTopic": "control",
        "defaultState": "open",
        "openCmd": "open",
        "closeCmd": "close",
        "toggleCmd": "toggle",
        "defaultCmd": "default",
        "statusCmd": "status",
        "persist": false,
        "storeName": "default",
        "x": 460,
        "y": 180,
        "wires": [["debug-open"], ["debug-blocked"]]
    },
    {
